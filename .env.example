# Modelo no formato "provider/modelo"
VLLM_MODEL=openai/modelo

# Endpoint OpenAI-compatible do vLLM (com /v1)
VLLM_BASE_URL=https://url-da-ia/v1

# Chave da API; use "EMPTY" para vLLM sem autenticação
VLLM_API_KEY=EMPTY

# (Opcional) Porta/host do servidor Mastra — já definidos no Dockerfile/compose
# PORT=4111
# MASTRA_HOST=0.0.0.0
